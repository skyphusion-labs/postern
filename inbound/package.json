{
  "name": "skyphusion-email-inbound",
  "version": "1.4.5",
  "private": true,
  "description": "CF Email Worker: ingests inbound mail into D1 + Vectorize for agent consumption",
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "routes:emit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/emit-route-table.mjs",
    "sync-webmail": "node scripts/sync-webmail.mjs",
    "setup-email-routing": "node scripts/setup-email-routing.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled=true --coverage.provider=istanbul --coverage.reporter=cobertura --coverage.reporter=text",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.0",
    "postcss": "8.5.25"
  }
}
